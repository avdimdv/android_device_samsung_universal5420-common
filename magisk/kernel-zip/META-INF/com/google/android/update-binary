#!/sbin/sh
# TWRP / recovery installer for the kernel swap (no Magisk needed in recovery).
# The Magisk app does not run this file: it installs the zip as a module (module.prop +
# customize.sh), which calls the same kernel/swap.sh.
umask 022
OUTFD=$2; ZIPFILE=$3
BOOTMODE=false
ps | grep zygote | grep -qv grep && BOOTMODE=true
$BOOTMODE || ps -A 2>/dev/null | grep zygote | grep -qv grep && BOOTMODE=true
ui_print() { if $BOOTMODE; then echo "$1"; else printf 'ui_print %s
ui_print
' "$1" >> /proc/self/fd/$OUTFD; fi; }
W=/dev/chagall_kernel_tmp
die() { ui_print " "; ui_print "! $1"; ui_print "! NOTHING WAS CHANGED."; rm -rf "$W"; exit 1; }
rm -rf "$W"; mkdir -p "$W" || { W=/tmp/chagall_kernel_tmp; rm -rf "$W"; mkdir -p "$W"; }
unzip -o "$ZIPFILE" 'kernel/*' -d "$W" >/dev/null 2>&1 || die "cannot unpack the zip"
. "$W/kernel/swap.sh"
kernel_swap
rm -rf "$W"
exit 0
