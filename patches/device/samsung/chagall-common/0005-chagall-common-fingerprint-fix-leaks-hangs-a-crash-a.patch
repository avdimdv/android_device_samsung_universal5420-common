+    /* gid and remaining_templates used to be left uninitialised (seen: gid=6,
+     * rem=69960371), so the framework's RemovalClient never saw "0 remaining" and
+     * Settings did not refresh after deleting a fingerprint. */
     fingerprint_msg_t msg;
+    memset(&msg, 0, sizeof(msg));
     msg.type = FINGERPRINT_TEMPLATE_REMOVED;
     msg.data.removed.finger.fid = fid;
+    msg.data.removed.finger.gid = vdev->active_gid;
+    msg.data.removed.remaining_templates = vcs_get_enrolled_finger_num();
 
     pthread_mutex_lock(&vdev->lock);
     vdev->device.notify(&msg);
@@ -526,17 +532,19 @@ static int fingerprint_cancel(struct fingerprint_device *device) {
         pthread_join(tz.timeout.timeout_thread, NULL);
         tz.timeout.timeout_thread = 0;
     }
-    if (get_tz_state() != STATE_IDLE && get_tz_state() != STATE_CANCEL) {
+    if (get_tz_state() == STATE_ENROLL || get_tz_state() == STATE_SCAN) {
         set_tz_state(STATE_CANCEL);
         ioctl(sensor.fd, VFSSPI_IOCTL_SET_DRDY_INT, &flag);
         pthread_mutex_lock(&sensor.lock);
         pthread_cond_signal(&sensor.cond);
         pthread_mutex_unlock(&sensor.lock);
-        while (1) {
+        /* Bounded: cancel() runs on a binder thread that system_server waits on; an
+         * endless wait here makes its watchdog kill and restart the whole framework. */
+        int waited;
+        for (waited = 0; waited < 30 && get_tz_state() != STATE_IDLE; waited++)
             usleep(100000);
-            if (tz.state == STATE_IDLE)
-                break;
-        }
+        if (get_tz_state() != STATE_IDLE)
+            ALOGE("cancel: worker did not stop within 3 s");
     }
 
     // Not really an error, but framework expects us to send it.
