 }
 
+/* A previous worker may still be winding down (STATE_CANCEL/STATE_EXIT): give it up to 1 s. */
+static int wait_for_idle(const char *who) {
+    int times;
+    for (times = 0; times < 10 && get_tz_state() != STATE_IDLE; times++)
+        usleep(100000);
+    if (get_tz_state() != STATE_IDLE) {
+        ALOGE("%s:Sensor is busy! (state %d)", who, get_tz_state());
+        return -1;
+    }
+    if (times) FPDBG("%s waited %d ms for the previous session", who, times * 100);
+    return 0;
+}
+
 int vcs_start_authenticate(void *vdev) {
-    int times = 0;
-    for (times = 0; times < 5; times++)
-        if (get_tz_state() != STATE_IDLE) {
-            ALOGE("%s:Sensor is busy!", __FUNCTION__);
-            if (times < 4) {
-                usleep(100000);
-                continue;
-            }
-            return -1;
-        }
