From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: avdim <avdimdv@gmail.com>
Date: Mon, 9 Nov 2026 23:54:13 +0100
Subject: [PATCH 1/2] chagall-common: audio: Raise main mic gain, fix
 out-of-range values

Calls and recordings with the built-in mic were very quiet. main-mic now
uses analog PGA +6 dB and digital +9 dB, about +15 dB in total. Two
other paths that set IN1L Volume to 24 now use 28.

The kernel rejects writes beyond a control's range, so these values never
took effect:
- voice-rec IN1x Volume 39/42: the analog PGA maximum is 31. Clamp to 31
  and raise the digital gain instead (135 -> 150).
- SPKOUTx Input 1/3 Volume 70: the mixer maximum is 48 (+16 dB). Use
  42 and 38.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Change-Id: I2640d2833d14b0deb0b168257acbe6587435bbe6
---
 configs/audio/mixer_paths_0.xml | 29 +++++++++++++++++------------
 1 file changed, 17 insertions(+), 12 deletions(-)

diff --git a/configs/audio/mixer_paths_0.xml b/configs/audio/mixer_paths_0.xml
index 043ef02..c67acfc 100644
--- a/configs/audio/mixer_paths_0.xml
+++ b/configs/audio/mixer_paths_0.xml
@@ -160,6 +160,7 @@
         <ctl name="HPOUT1R Input 2" value="ASRC2R" />
     </path>
 
+
     <!-- ########## Capture ########## -->
 
     <path name="main-mic">
@@ -170,8 +171,9 @@
         <ctl name="LHPF1 Input 1" value="IN1L" />
         <ctl name="AIF2TX1 Input 1" value="ASRC1L" />
         <ctl name="AIF2TX2 Input 1" value="ASRC1R" />
-        <ctl name="IN1L Volume" value="24" />
-        <ctl name="IN1L Digital Volume" value="128" />
+        <!-- MOD: was 24 / 128. Analog PGA +6 dB, digital +9 dB = +15 dB total -->
+        <ctl name="IN1L Volume" value="30" />
+        <ctl name="IN1L Digital Volume" value="146" />
         <ctl name="LHPF1 Input 1 Volume" value="32" />
     </path>
 
@@ -286,11 +288,12 @@
 
     <path name="voice-speaker">
         <path name="speaker" />
+        <!-- MOD: 70 is out of range (mixer max 48 = +16 dB), kernel rejected it -->
         <ctl name="Speaker Digital Volume" value="128" />
-        <ctl name="SPKOUTL Input 1 Volume" value="70" />
-        <ctl name="SPKOUTR Input 1 Volume" value="70" />
-        <ctl name="SPKOUTL Input 3 Volume" value="70" />
-        <ctl name="SPKOUTR Input 3 Volume" value="70" />
+        <ctl name="SPKOUTL Input 1 Volume" value="42" />
+        <ctl name="SPKOUTR Input 1 Volume" value="42" />
+        <ctl name="SPKOUTL Input 3 Volume" value="38" />
+        <ctl name="SPKOUTR Input 3 Volume" value="38" />
     </path>
 
     <path name="voice-speaker-wb">
@@ -347,14 +350,14 @@
     <path name="voice-mic">
         <path name="main-mic" />
         <ctl name="IN1L Volume" value="30" />
-        <ctl name="IN1L Digital Volume" value="128" />
+        <ctl name="IN1L Digital Volume" value="146" />
         <ctl name="LHPF1 Input 1 Volume" value="32" />
     </path>
 
     <!-- Two mic -->
     <path name="voice-earpiece-mic">
         <path name="main-mic" />
-        <ctl name="IN1L Volume" value="24" />
+        <ctl name="IN1L Volume" value="28" />
         <ctl name="IN1L Digital Volume" value="150" />
         <ctl name="LHPF1 Input 1 Volume" value="32" />
 
@@ -370,7 +373,7 @@
 
     <path name="voice-speaker-mic">
         <path name="main-mic" />
-        <ctl name="IN1L Volume" value="24" />
+        <ctl name="IN1L Volume" value="28" />
         <ctl name="IN1L Digital Volume" value="150" />
         <ctl name="LHPF1 Input 1 Volume" value="32" />
 
@@ -413,15 +416,17 @@
 
     <path name="voice-rec-headset-mic">
         <path name="headset-mic" />
-        <ctl name="IN1R Volume" value="39" />
+        <!-- MOD: 39 out of range (analog PGA max 31) -->
+        <ctl name="IN1R Volume" value="31" />
         <ctl name="IN1R Digital Volume" value="141" />
         <ctl name="LHPF1 Input 1 Volume" value="32" />
     </path>
 
     <path name="voice-rec-mic">
         <path name="main-mic" />
-        <ctl name="IN1L Volume" value="42" />
-        <ctl name="IN1L Digital Volume" value="135" />
+        <!-- MOD: 42 out of range (analog PGA max 31); digital 135 -> 150 -->
+        <ctl name="IN1L Volume" value="31" />
+        <ctl name="IN1L Digital Volume" value="150" />
         <ctl name="LHPF1 Input 1 Volume" value="32" />
     </path>
 
-- 
2.25.1

