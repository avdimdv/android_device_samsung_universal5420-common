diff --git a/core/java/com/android/internal/util/GmsIntegritySpoof.java b/core/java/com/android/internal/util/GmsIntegritySpoof.java
new file mode 100755
index 000000000000..ad18c34f02dc
--- /dev/null
+++ b/core/java/com/android/internal/util/GmsIntegritySpoof.java
@@ -0,0 +1,177 @@
+/*
+ * Play Integrity (basic level) support for ROMs without root.
+ *
+ * Inside Google Play services' processes (com.google.android.gms*) and the Play Store
+ * (com.android.vending*), and only there:
+ *  - the process gets a PRIVATE copy-on-write view of the system property memory in which a few
+ *    properties that reveal a debug / modified device are rewritten (ro.debuggable, ro.build.type,
+ *    ro.build.tags, ro.boot.warranty_bit). Native code (DroidGuard) reads them from there. The rest of
+ *    the system keeps the real values: telling the whole system (e.g. ro.debuggable=0 for the
+ *    framework) makes the check fail, tested with the PIF Magisk module's setup on the same phone.
+ *  - in com.google.android.gms.unstable (DroidGuard) and, if "spoofVendingBuild" is true, in the
+ *    Play Store the Java values of android.os.Build and the Java system property reads are replaced
+ *    with those of a certified device from /system/etc/pif.json (same fields as the pif.prop of the
+ *    "Play Integrity Fix" module); hardware key attestation is refused to DroidGuard callers.
+ * Without the json file nothing happens. Values go stale when Google blocks a fingerprint: replace the
+ * json, no rebuild needed. Optional json object "nativeProps" overrides the default native list.
+ */
+package com.android.internal.util;
+
+import android.os.Build;
+import android.os.SystemProperties;
+import android.util.Log;
+
+import org.json.JSONObject;
+
+import java.io.File;
+import java.io.FileInputStream;
+import java.lang.reflect.Field;
+import java.nio.charset.StandardCharsets;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+
+/** @hide */
+public final class GmsIntegritySpoof {
+    private static final String TAG = "GmsIntegritySpoof";
+    private static final String GMS_PREFIX = "com.google.android.gms";
+    private static final String GMS_DROIDGUARD = "com.google.android.gms.unstable";
+    private static final String VENDING_PREFIX = "com.android.vending";
+    private static final String CONFIG = "/system/etc/pif.json";
+
+    /** True only inside a Java-spoofed process after the values were applied. */
+    public static volatile boolean sActive = false;
+    private static volatile Map<String, String> sProps = null;
+
+    private GmsIntegritySpoof() {}
+
+    /** Called from ActivityThread.handleBindApplication before any app code runs. */
+    public static void apply(String processName) {
+        if (processName == null) return;
+        boolean gms = processName.startsWith(GMS_PREFIX);
+        boolean vending = processName.startsWith(VENDING_PREFIX);
+        if (!gms && !vending) return;
+        try {
+            File f = new File(CONFIG);
+            if (!f.canRead()) return;
+            byte[] buf = new byte[(int) f.length()];
+            try (FileInputStream in = new FileInputStream(f)) {
+                int off = 0;
+                while (off < buf.length) {
+                    int n = in.read(buf, off, buf.length - off);
+                    if (n < 0) break;
+                    off += n;
+                }
+            }
+            JSONObject json = new JSONObject(new String(buf, StandardCharsets.UTF_8));
+
+            // 1. native view of the properties, private to this process
+            applyNativeProps(processName, json);
+
+            // 2. Java side: only DroidGuard and (optionally) the Play Store
+            boolean javaSpoof = GMS_DROIDGUARD.equals(processName)
+                    || (VENDING_PREFIX.equals(processName) && json.optBoolean("spoofVendingBuild", false));
+            if (!javaSpoof) return;
+
+            Map<String, String> props = new HashMap<>();
+            String fp = json.optString("FINGERPRINT", "");
+            if (!fp.isEmpty()) {
+                // BRAND/PRODUCT/DEVICE:RELEASE/ID/INCREMENTAL:TYPE/TAGS
+                String[] a = fp.split("[/:]");
+                if (a.length >= 8) {
+                    setField("BRAND", a[0]);
+                    setField("PRODUCT", a[1]);
+                    setField("DEVICE", a[2]);
+                    setField("ID", a[4]);
+                    setField("INCREMENTAL", a[5]);
+                    setField("TYPE", a[6]);
+                    setField("TAGS", a[7]);
+                    props.put("ro.product.brand", a[0]);
+                    props.put("ro.product.name", a[1]);
+                    props.put("ro.product.device", a[2]);
+                    props.put("ro.build.id", a[4]);
+                }
+                setField("FINGERPRINT", fp);
+                props.put("ro.build.fingerprint", fp);
+                props.put("ro.system.build.fingerprint", fp);
+                props.put("ro.vendor.build.fingerprint", fp);
+                props.put("ro.bootimage.build.fingerprint", fp);
+            }
+            String v = json.optString("MODEL", "");
+            if (!v.isEmpty()) { setField("MODEL", v); props.put("ro.product.model", v); }
+            v = json.optString("MANUFACTURER", "");
+            if (!v.isEmpty()) { setField("MANUFACTURER", v); props.put("ro.product.manufacturer", v); }
+            v = json.optString("SECURITY_PATCH", "");
+            if (!v.isEmpty()) { setField("SECURITY_PATCH", v); props.put("ro.build.version.security_patch", v); }
+            v = json.optString("DEVICE_INITIAL_SDK_INT", "");
+            if (!v.isEmpty()) { setField("FIRST_SDK_INT", v); props.put("ro.product.first_api_level", v); }
+
+            sProps = props;
+            sActive = true;
+            Log.i(TAG, "Build values replaced in " + processName);
+        } catch (Throwable t) {
+            Log.w(TAG, "not applied: " + t);
+        }
+    }
+
+    private static void applyNativeProps(String processName, JSONObject json) {
+        Map<String, String> nat = new HashMap<>();
+        JSONObject custom = json.optJSONObject("nativeProps");
+        if (custom != null) {
+            Iterator<String> it = custom.keys();
+            while (it.hasNext()) {
+                String k = it.next();
+                nat.put(k, custom.optString(k));
+            }
+        } else {
+            nat.put("ro.debuggable", "0");
+            nat.put("ro.build.type", "user");
+            nat.put("ro.build.tags", "release-keys");
+            nat.put("ro.boot.warranty_bit", "0");
+        }
+        String[] keys = nat.keySet().toArray(new String[0]);
+        String[] vals = new String[keys.length];
+        for (int i = 0; i < keys.length; i++) vals[i] = nat.get(keys[i]);
+        boolean ok = SystemProperties.privateOverride(keys, vals);
+        Log.i(TAG, "native property view of " + processName + (ok ? " rewritten" : " NOT rewritten"));
+    }
+
+    private static void setField(String name, Object value) {
+        Class<?>[] holders = { Build.class, Build.VERSION.class };
+        for (Class<?> c : holders) {
+            try {
+                Field field = c.getDeclaredField(name);
+                field.setAccessible(true);
+                if (field.getType() == int.class) {
+                    field.setInt(null, Integer.parseInt(String.valueOf(value)));
+                } else if (field.getType() == String.class) {
+                    field.set(null, String.valueOf(value));
+                } else {
+                    continue;
+                }
+                return;
+            } catch (NoSuchFieldException e) {
+                // try the next holder
+            } catch (Throwable t) {
+                Log.w(TAG, "field " + name + ": " + t);
+                return;
+            }
+        }
+    }
+
+    /** Replacement value for a Java system property read inside a Java-spoofed process, or null. */
+    public static String overrideProp(String key) {
+        if (!sActive) return null;
+        Map<String, String> p = sProps;
+        return p == null ? null : p.get(key);
+    }
+
+    /** True when the current call comes from Google's DroidGuard / attestation code. */
+    public static boolean isAttestationCaller() {
+        if (!sActive) return false;
+        for (StackTraceElement e : Thread.currentThread().getStackTrace()) {
+            if (e.getClassName().toLowerCase().contains("droidguard")) return true;
+        }
+        return false;
+    }
+}
\ No newline at end of file
