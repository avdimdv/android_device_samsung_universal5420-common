@@ -152,6 +162,70 @@ void SystemProperties_report_sysprop_change(JNIEnv /**env*/, jobject /*clazz*/)
     report_sysprop_change();
 }
 
+
+// Play Integrity support (GmsIntegritySpoof): give THIS process a private copy-on-write view of the
+// system property memory and rewrite some values there. Pages are only copied when written, so later
+// property changes by init stay visible; nothing outside this process changes.
+jboolean SystemProperties_privateOverride(JNIEnv* env, jclass /*clazz*/, jobjectArray keys,
+                                          jobjectArray values) {
+    struct Region { unsigned long start; size_t len; off_t off; std::string path; };
+    std::vector<Region> regions;
+    FILE* maps = fopen("/proc/self/maps", "re");
+    if (maps == nullptr) return JNI_FALSE;
+    char line[1024];
+    while (fgets(line, sizeof(line), maps) != nullptr) {
+        unsigned long start, end, off;
+        char path[512];
+        path[0] = 0;
+        if (sscanf(line, "%lx-%lx %*4s %lx %*s %*s %511s", &start, &end, &off, path) < 3) continue;
+        if (strncmp(path, "/dev/__properties__/", 20) != 0) continue;
+        regions.push_back({start, static_cast<size_t>(end - start), static_cast<off_t>(off), path});
+    }
+    fclose(maps);
+    if (regions.empty()) return JNI_FALSE;
+
+    for (const Region& r : regions) {
+        int fd = open(r.path.c_str(), O_RDONLY | O_CLOEXEC);
+        if (fd < 0) {
+            ALOGW("privateOverride: cannot open %s", r.path.c_str());
+            return JNI_FALSE;
+        }
+        void* p = mmap(reinterpret_cast<void*>(r.start), r.len, PROT_READ | PROT_WRITE,
+                       MAP_PRIVATE | MAP_FIXED, fd, r.off);
+        close(fd);
+        if (p == MAP_FAILED) {
+            ALOGW("privateOverride: cannot remap %s", r.path.c_str());
+            return JNI_FALSE;
+        }
+    }
+
+    int updated = 0;
+    jsize n = env->GetArrayLength(keys);
+    for (jsize i = 0; i < n; i++) {
+        ScopedUtfChars k(env, static_cast<jstring>(env->GetObjectArrayElement(keys, i)));
+        ScopedUtfChars v(env, static_cast<jstring>(env->GetObjectArrayElement(values, i)));
+        if (k.c_str() == nullptr || v.c_str() == nullptr) continue;
+        // __system_property_update() is not exported to platform libraries (init only), so write the
+        // record directly, the way bionic does it (dirty bit, value, new serial with the length in
+        // the top byte). The memory is this process's private copy, so no futex wake is needed.
+        struct PropRecord { std::atomic<uint32_t> serial; char value[PROP_VALUE_MAX]; };
+        const size_t len = strlen(v.c_str());
+        PropRecord* pi = reinterpret_cast<PropRecord*>(
+                const_cast<prop_info*>(__system_property_find(k.c_str())));
+        if (pi == nullptr || len >= PROP_VALUE_MAX) continue;
+        uint32_t serial = pi->serial.load(std::memory_order_relaxed);
+        if (serial & (1u << 16)) continue;  // "long" property: value lives elsewhere
+        serial |= 1;  // dirty bit; the final serial below is (this + 1), i.e. clean again
+        pi->serial.store(serial, std::memory_order_relaxed);
+        std::atomic_thread_fence(std::memory_order_release);
+        strlcpy(pi->value, v.c_str(), PROP_VALUE_MAX);
+        pi->serial.store((static_cast<uint32_t>(len) << 24) | ((serial + 1) & 0xffffff),
+                         std::memory_order_release);
+        updated++;
+    }
+    return updated > 0 ? JNI_TRUE : JNI_FALSE;
+}
+
 }  // namespace
 
 int register_android_os_SystemProperties(JNIEnv *env)
@@ -174,6 +248,8 @@ int register_android_os_SystemProperties(JNIEnv *env)
           (void*) SystemProperties_add_change_callback },
         { "native_report_sysprop_change", "()V",
           (void*) SystemProperties_report_sysprop_change },
+        { "native_private_override", "([Ljava/lang/String;[Ljava/lang/String;)Z",
+          (void*) SystemProperties_privateOverride },
     };
     return RegisterMethodsOrDie(env, "android/os/SystemProperties",
                                 method_table, NELEM(method_table));
